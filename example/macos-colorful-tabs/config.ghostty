# Colorful tabs example configuration (macOS)
#
# Run it without your own configuration:
#
#   ghostty --config-default-files=false --config-file=config.ghostty
#
# (`config-default-files = false` only works as a command line flag.)
# Reload after editing with Cmd+Shift+,
#
# How a tab's colors are chosen, highest priority first:
#
#   1. A color picked from the tab's right-click "Tab Color" menu. If a
#      `tab-color-palette` entry has the same name as the picked color, the
#      entry's colors are used. Otherwise the built-in system color is the
#      background and `tab-foreground-active` is the text color.
#   2. The `tab-*` keys below.
#   3. Ghostty's normal tab look. With none of these keys set, tabs look
#      exactly as they always have.
#
# Colors can be `#RRGGBB`, `RRGGBB`, or a named X11 color such as `red`.
# Palette entries take hex colors only.

# Style of the window the tabs live in: native | tabs | transparent | hidden
# Tab colors work with all of them.
macos-titlebar-style = native

# Tab colors

# Background and text color of the selected tab.
tab-background-active = #3b4252
tab-foreground-active = #ffffff

# Background and text color of the other tabs. When unset, they are the active
# colors dimmed to 65%. Uncomment to set them yourself.
#
# tab-background-inactive = #2e3440
# tab-foreground-inactive = #81a1c1

# Opacity of tab backgrounds, for active and inactive tabs alike, from 0.01 to
# 1.0. Values outside that range are clamped. 1.0 is solid.
tab-background-opacity = 0.85

# The right-click color picker
#
# The picker has nine swatches. Each `tab-color-palette` line replaces the
# look of the swatch with the same name:
#
#   blue  purple  pink  red  orange  yellow  green  teal  graphite
#
# Names are matched ignoring case. Swatches without a line keep the system
# color. A line with any other name has no swatch. If two lines have the same
# name, the later one wins.
#
# Format (one entry per line, repeat the key for more entries):
#
#   tab-color-palette = name:bg=#RRGGBB,fg=#RRGGBB,inactive-bg=#RRGGBB,inactive-fg=#RRGGBB
#
#   name         the swatch name above
#   bg, fg       required. Selected tab's background and text color.
#   inactive-bg  optional. Defaults to `bg` dimmed to 65%.
#   inactive-fg  optional. Defaults to `fg` dimmed to 65%.
#
# Unknown keys in an entry are ignored.
tab-color-palette = blue:bg=#5e81ac,fg=#ffffff
tab-color-palette = purple:bg=#b48ead,fg=#1d1f27
tab-color-palette = pink:bg=#d18bb8,fg=#1d1f27
tab-color-palette = red:bg=#bf616a,fg=#ffffff
tab-color-palette = orange:bg=#d08770,fg=#1d1f27
tab-color-palette = yellow:bg=#ebcb8b,fg=#1d1f27
tab-color-palette = green:bg=#a3be8c,fg=#1d1f27
tab-color-palette = teal:bg=#88c0d0,fg=#1d1f27

# Colors for a picked tab's inactive state can be set explicitly.
tab-color-palette = graphite:bg=#4c566a,fg=#eceff4,inactive-bg=#3b4252,inactive-fg=#a0a8b8

# macOS accessibility settings
#
# These apply on top of everything above, and need no configuration:
#
#   Reduce Transparency  forces `tab-background-opacity` to 1.0.
#   Increase Contrast    makes any text that is below a 4.5:1 contrast ratio
#                        with its background black or white instead.
#
# Tab colors also follow the system light and dark appearance.
